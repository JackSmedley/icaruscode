#include "detsim_2d_icarus_fitFR_oldgain.fcl"

#Light level tune consistent with https://github.com/SBNSoftware/icaruscode/pull/663 and https://github.com/SBNSoftware/icarusalg/pull/78
#Note that our nominal MC release was before the light level tuning, so this replicates the tuning that went into place after
#Paired with cosmics_g4_icarus_sce_lightLevel.fcl

#Reduce PMT quantum efficiency
services.LArPropertiesService.ScintPreScale: 0.073
physics.producers.opdaq.QE: 0.073

#Reduce PMT gain
physics.producers.opdaq.PMTspecs.Gain: 7.5e6
physics.producers.opdaq.SinglePhotonResponse.Gain: 7.5e6

